{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cunabit",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-10-01",
  // URL de producción: cunabit.mabarcodev.workers.dev. Explícito para que ningún deploy la desactive.
  "workers_dev": true,
  // Solo se publica public/: el resto del repo (tests, docs, scripts) nunca se sube como asset.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "PAIRING", "class_name": "PairingBox" },
      { "name": "RATE_LIMITER", "class_name": "RateLimiter" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["PairingBox", "RateLimiter"] }
  ],
  // Se guardan solo los console.error del Worker (sin IPs ni payloads), no un registro por petición.
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": false }
  }
}
